{
  "name": "granule",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic GPU matter sandbox and puzzle game in development",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests tools *.ts *.js *.json *.md index.html",
    "benchmark": "node tools/benchmark.mjs",
    "test:production": "node tools/check-production.mjs",
    "test:soak": "node tools/soak.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
